# XActions Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# x402 Payment Configuration (AI Agent Monetization)
# ═══════════════════════════════════════════════════════════════════════════════

# ⚠️  REQUIRED for production - your wallet address to receive USDC payments
# This MUST be set to a valid Ethereum address (0x...) for x402 to work
# Server will fail to start in production if this is not configured
X402_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Network: which blockchain to use for payments
#   eip155:8453  = Base mainnet (REAL money - use for production)
#   eip155:84532 = Base Sepolia testnet (TEST money - use for development)
# Defaults: testnet in development, mainnet in production
X402_NETWORK=eip155:84532

# Facilitator URL for payment verification and settlement
# Default works for most cases, only change if using custom facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator

# Debug logging for x402 payments (optional)
X402_DEBUG=false

# Skip payment verification in development (NEVER use in production!)
# Uncomment ONLY for local testing without a wallet
# X402_SKIP_VERIFICATION=true

# ═══════════════════════════════════════════════════════════════════════════════
# Payment Webhook Notifications (Optional - for revenue tracking)
# ═══════════════════════════════════════════════════════════════════════════════

# Custom webhook URL - receives JSON POST for all payment events
# This is the recommended option - just point to your own endpoint
# Payload: { event, timestamp, data: { amount, operation, payer, network, txHash } }
X402_WEBHOOK_URL=https://your-server.com/webhooks/payments

# Webhook signature secret (optional but recommended for production)
# Signs payloads with HMAC-SHA256 for security
# Verify: X-Webhook-Signature header = HMAC-SHA256(timestamp.payload, secret)
# Generate with: openssl rand -hex 32
X402_WEBHOOK_SECRET=

# Optional: Discord/Slack webhooks (leave empty if not using)
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# Stripe Billing (Subscription Payments)
# ═══════════════════════════════════════════════════════════════════════════════

# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — from Stripe Dashboard > Webhooks > Signing secret
# Endpoint URL: https://your-domain.com/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in Stripe Dashboard > Products
# Each should be a recurring monthly price
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ═══════════════════════════════════════════════════════════════════════════════
# MCP Server Configuration (for AI agents like Claude)
# ═══════════════════════════════════════════════════════════════════════════════

# MCP mode: local (free, uses Puppeteer) or remote (paid, uses x402 API)
XACTIONS_MODE=local

# API URL for remote mode
XACTIONS_API_URL=https://api.xactions.app

# Private key for x402 payments (remote mode only)
# ⚠️ NEVER commit this value! Use a separate wallet for payments.
# X402_PRIVATE_KEY=0xYourPrivateKey

# X/Twitter session cookie for authentication
XACTIONS_SESSION_COOKIE=

# ═══════════════════════════════════════════════════════════════════════════════
# Database (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL="postgresql://user:password@localhost:5432/xactions?schema=public"

# ═══════════════════════════════════════════════════════════════════════════════
# Authentication & Security
# ═══════════════════════════════════════════════════════════════════════════════

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-key

# Dedicated key for encrypting stored X session cookies at rest (AES-256-GCM).
# Falls back to SESSION_SECRET, then JWT_SECRET, when unset. Generate with: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# Admin API key for accessing admin endpoints (payment stats, webhook management)
# Generate a secure random string: openssl rand -hex 32
ADMIN_API_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://xactions.app

# ═══════════════════════════════════════════════════════════════════════════════
# Twitter/X OAuth 2.0
# ═══════════════════════════════════════════════════════════════════════════════

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ═══════════════════════════════════════════════════════════════════════════════
# Redis (for job queue)
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# EarlyBird X -> WeChat draft pipeline
# ═══════════════════════════════════════════════════════════════════════════════

# X cookie string used by the HTTP timeline poller (auth_token=...; ct0=...)
X_COOKIES=
# Optional Netscape/Cookie-Editor export. Its values override duplicate X_COOKIES names.
EARLYBIRD_X_COOKIES_FILE=
# Optional HTTP/SOCKS proxy when this deployment cannot reach x.com directly.
EARLYBIRD_X_PROXY=
EARLYBIRD_MEDIA_DIR=./data/earlybird/media
# Windows host directory shown in the Feishu draft notification for manual video upload.
EARLYBIRD_HOST_MEDIA_DIR=E:/Group-projects/EarlyBird-Pulse/XActions/data/earlybird/media
EARLYBIRD_PUBLIC_MEDIA_URL=
EARLYBIRD_THREAD_WAIT_MS=90000
EARLYBIRD_THREAD_TIMEOUT_MS=60000
EARLYBIRD_CONCURRENCY=1
# New posts wait for the next editorial batch. The default is 30 minutes.
EARLYBIRD_EDITORIAL_BATCH_MINUTES=30
# Maximum searches initiated by the editorial orchestrator are fixed in code:
# 3 X queries and 3 Tavily web queries, each with a small result cap.
# Spread source polls across their five-minute window.
EARLYBIRD_SOURCE_MIN_REQUEST_INTERVAL_MS=30000

# OpenAI-compatible multimodal endpoint (OpenAI, Anthropic/Gemini gateway, or OpenRouter)
EARLYBIRD_LLM_API_KEY=
EARLYBIRD_LLM_BASE_URL=https://api.openai.com/v1
EARLYBIRD_LLM_MODEL=gpt-4o-mini
EARLYBIRD_ARTICLE_MAX_TOKENS=6000
# Optional OpenAI-compatible fallback used only after the primary LLM fails.
EARLYBIRD_LLM_FALLBACK_API_KEY=
EARLYBIRD_LLM_FALLBACK_BASE_URL=
EARLYBIRD_LLM_FALLBACK_MODEL=
# The independent editorial agents reuse EARLYBIRD_LLM_* above.
# Tavily Search finds full-web article visuals and stores their image-source attribution.
EARLYBIRD_TAVILY_API_KEY=
EARLYBIRD_STT_API_KEY=
EARLYBIRD_STT_MODEL=gpt-4o-mini-transcribe

# OpenAI-compatible image generation for a 900x383 WeChat article cover.
# The primary model is retried with the fallback model before original post media is used.
EARLYBIRD_COVER_IMAGE_ENABLED=true
EARLYBIRD_COVER_IMAGE_API_KEY=
EARLYBIRD_COVER_IMAGE_BASE_URL=
EARLYBIRD_COVER_IMAGE_MODEL=gemini-3.1-flash-image
EARLYBIRD_COVER_IMAGE_FALLBACK_API_KEY=
EARLYBIRD_COVER_IMAGE_FALLBACK_BASE_URL=
EARLYBIRD_COVER_IMAGE_FALLBACK_MODEL=grok-imagine-image-2.0
# Style preset: editorial (default), cyberpunk, minimalist, clay, photorealistic, flat
EARLYBIRD_COVER_IMAGE_STYLE=editorial
# Custom style prompt overrides the design system description in the prompt
EARLYBIRD_COVER_IMAGE_STYLE_PROMPT=
# Additional negative prompt appended to the base anti-text/anti-watermark constraints
EARLYBIRD_COVER_IMAGE_NEGATIVE_PROMPT=
# Generation resolution passed to the image API (default: 1536x1024, normalized to 900x383)
EARLYBIRD_COVER_IMAGE_SIZE=1536x1024


# Hermes relay sends finished drafts and the fixed daily summary through your configured Feishu bot.
# The relay token stays in data/earlybird/hermes-relay.token and is never committed.
EARLYBIRD_HERMES_RELAY_URL=http://host.docker.internal:8767/notify
EARLYBIRD_HERMES_TIMEOUT_MS=45000
EARLYBIRD_DAILY_SUMMARY_CRON="0 21 * * *"
EARLYBIRD_DAILY_EDITORIAL_REVIEW_CRON="0 9,17 * * *"

# WeChat Official Account credentials; never log or commit these values
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=

# ═══════════════════════════════════════════════════════════════════════════════
# Puppeteer Configuration (for local mode)
# ═══════════════════════════════════════════════════════════════════════════════

PUPPETEER_HEADLESS=true
PUPPETEER_NO_SANDBOX=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ═══════════════════════════════════════════════════════════════════════════════
# Logging & Monitoring
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info
# SENTRY_DSN=https://xxx@sentry.io/xxx

