generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EarlyBirdSource {
  id                  String                @id @default(cuid())
  handle              String                @unique
  displayName         String?
  website             String?
  enabled             Boolean               @default(true)
  pollIntervalSeconds Int                   @default(60)
  baselineComplete    Boolean               @default(false)
  lastSeenCreatedAt   DateTime?
  lastSeenPostId      String?
  lastPolledAt        DateTime?
  lastError           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  posts               EarlyBirdPost[]
  jobs                EarlyBirdArticleJob[]
  polls               EarlyBirdPoll[]
}

model EarlyBirdPoll {
  id            String          @id @default(cuid())
  sourceId      String
  outcome       String
  detectedCount Int             @default(0)
  postIds       Json?
  error         String?
  polledAt      DateTime        @default(now())
  source        EarlyBirdSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, polledAt])
  @@index([outcome, polledAt])
}

model EarlyBirdPost {
  id             String                @id @default(cuid())
  sourceId       String
  postId         String
  rootPostId     String?
  sourceUrl      String
  authorUsername String
  text           String                @default("")
  createdAt      DateTime?
  rawData        Json
  threadData     Json?
  mediaData      Json?
  capturedAt     DateTime              @default(now())
  source         EarlyBirdSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  assets         EarlyBirdAsset[]
  jobs           EarlyBirdArticleJob[]

  @@unique([sourceId, postId])
  @@index([rootPostId])
  @@index([createdAt])
}

model EarlyBirdAsset {
  id            String        @id @default(cuid())
  postId        String
  kind          String
  sourceUrl     String
  localPath     String?
  publicUrl     String?
  sha256        String?
  mimeType      String?
  status        String        @default("pending")
  metadata      Json?
  wechatMediaId String?
  wechatUrl     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  post          EarlyBirdPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sourceUrl])
  @@index([sha256])
}

model EarlyBirdArticleJob {
  id             String          @id @default(cuid())
  sourceId       String
  postId         String          @unique
  status         String          @default("detected")
  attempts       Int             @default(0)
  error          String?
  markdown       String?
  html           String?
  humanizerScore Int?
  metadata       Json?
  detectedAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  source         EarlyBirdSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  post           EarlyBirdPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  draft          EarlyBirdDraft?
  editorialReviews EarlyBirdEditorialReview[]
  draftReplacements EarlyBirdDraftReplacement[]

  @@index([status, updatedAt])
}

model EarlyBirdDraft {
  id             String              @id @default(cuid())
  jobId          String              @unique
  mediaId        String              @unique
  requestSummary Json?
  verification   Json?
  verified       Boolean             @default(false)
  failureReason  String?
  deletedAt      DateTime?
  deleteError    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  job            EarlyBirdArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model EarlyBirdEditorialReview {
  id                  String              @id @default(cuid())
  jobId               String
  phase               String
  attempt             Int                 @default(1)
  decision            String
  contentType         String?
  qualityScore        Int?
  issues              Json?
  rewriteInstructions String?
  visualPlan          Json?
  relatedJobIds       Json?
  inputHash           String
  output              Json
  createdAt           DateTime            @default(now())
  job                 EarlyBirdArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([decision, createdAt])
}

model EarlyBirdDraftReplacement {
  id         String              @id @default(cuid())
  jobId      String
  oldMediaId String?
  newMediaId String
  status     String              @default("pending")
  error      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  job        EarlyBirdArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([newMediaId])
  @@index([status, updatedAt])
}

model EarlyBirdNotification {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  kind      String
  status    String   @default("pending")
  payload   Json
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([status, updatedAt])
}
